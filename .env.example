# Server-only Groq credentials used by the portfolio chatbot.
GROQ_API_KEY=
# Optional model override; defaults to qwen/qwen3.8-27b.
GROQ_CHAT_MODEL=qwen/qwen3.8-27b
# Server-only GitHub token for the homepage contribution city. A fine-grained
# token with no repository permissions is enough (public data only). Without
# it the GitHub section is simply not rendered.
GITHUB_TOKEN=
